# =====================================================================
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env
#   PowerShell:  Copy-Item .env.example .env
# =====================================================================

# ID của Google Cloud project (KHÔNG phải project name/number)
GCP_PROJECT_ID=my-gcp-project-id

# Vùng chạy BigQuery. Phải trùng với location của dataset.
#   Ví dụ: US | EU | asia-southeast1 (Singapore) | asia-east1
BQ_LOCATION=asia-southeast1

# Dataset chứa dữ liệu thô do script Python nạp lên (landing zone)
BQ_RAW_DATASET=raw_ecommerce

# Dataset đích cho dbt build ra. Mỗi dev nên dùng một dataset riêng,
# ví dụ dbt_tam, để không ghi đè lên nhau.
BQ_DBT_DATASET=dbt_dev

# Số luồng dbt chạy song song (4-8 là hợp lý với BigQuery)
DBT_THREADS=4

# Thư mục chứa profiles.yml — trỏ vào chính repo này
DBT_PROFILES_DIR=.
