# =====================================================================
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env
#   PowerShell:  Copy-Item .env.example .env
# =====================================================================

# ID của Google Cloud project (KHÔNG phải project name/number)
GCP_PROJECT_ID=my-gcp-project-id

# Vùng chạy BigQuery. Phải trùng với location của dataset.
#   Ví dụ: US | EU | asia-southeast1 (Singapore) | asia-east1
BQ_LOCATION=asia-southeast1

# Dataset chứa dữ liệu thô do script Python nạp lên (landing zone)
BQ_RAW_DATASET=raw_ecommerce

# Dataset đích cho dbt build ra. Mỗi dev nên dùng một dataset riêng,
# ví dụ dbt_tam, để không ghi đè lên nhau.
BQ_DBT_DATASET=dbt_dev

# Số luồng dbt chạy song song (4-8 là hợp lý với BigQuery)
DBT_THREADS=4

# Thư mục chứa profiles.yml — trỏ vào chính repo này
DBT_PROFILES_DIR=.

# ---------------------------------------------------------------------
# Chỉ cần khi chạy target prod / ci (Airflow trong WSL). Bỏ trống khi dev local.
# ---------------------------------------------------------------------

# Đường dẫn TUYỆT ĐỐI tới file JSON key của service account.
# Đặt trên ext4 của WSL (~/secrets/), đừng để dưới /mnt/c: DrvFs bỏ qua chmod
# nên key sẽ world-readable với mọi tiến trình Windows.
GCP_SA_KEYFILE=

# dbt đọc GCP_SA_KEYFILE, còn scripts/*.py dùng bigquery.Client() nên đọc biến
# này. Hai biến PHẢI trỏ cùng một file — lệch nhau sẽ ra lỗi rất khó hiểu:
# dbt chạy ngon mà script nạp CSV thì DefaultCredentialsError.
GOOGLE_APPLICATION_CREDENTIALS=

# Dataset gốc của target prod.
# Lưu ý: macro generate_schema_name trả về tên schema THÔ khi target là prod,
# nên marts thật sự nằm ở dataset "marts" chứ không phải "analytics_marts".
# BQ_PROD_DATASET chỉ áp dụng cho model không khai báo +schema.
BQ_PROD_DATASET=analytics

# Dataset gốc cho build từ Pull Request (target ci). DAG git_pr_builds ghi đè
# thành pr_<số PR> để mỗi PR có một bộ dataset riêng, không đụng prod.
BQ_CI_DATASET=ci_pr

# BẮT BUỘC trên Windows dùng ngôn ngữ tiếng Việt.
# Mặc định Python đọc file theo codepage hệ thống (cp1258), sẽ báo lỗi
# UnicodeDecodeError khi gặp tiếng Việt trong file .yml/.sql.
# Đặt =1 để Python luôn đọc/ghi bằng UTF-8.
PYTHONUTF8=1
