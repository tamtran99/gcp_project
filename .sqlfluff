[sqlfluff]
dialect = bigquery
templater = dbt
max_line_length = 88

# Bỏ qua các rule hay gây nhiễu trong dự án dbt
exclude_rules = ST06, RF01, AM04

[sqlfluff:templater:dbt]
project_dir = ./
profiles_dir = ./
profile = ecommerce_analytics
target = dev

[sqlfluff:indentation]
tab_space_size = 4
indented_joins = false
indented_ctes = false

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

# Repo cố ý căn thẳng cột 'as' cho dễ đọc, nên LT01 mặc định sẽ báo lỗi
# "Expected only single space before 'as' keyword" ở mọi model.
#
# KHÔNG tắt cả LT01 để xử lý việc này: rule đó còn bắt trailing whitespace và
# thiếu space quanh toán tử. Chỉ gỡ ràng buộc spacing của riêng alias.
#
# Vì sao 'any' chứ không phải 'align': repo căn 'as' theo TỪNG NHÓM cột (ngăn
# bởi dòng trống hoặc comment), mỗi nhóm một mốc riêng. Chế độ 'align' của
# sqlfluff chỉ căn được theo trọn select_clause = một mốc duy nhất, nên nó báo
# lỗi chính cái style này. sqlfluff không diễn đạt được alignment theo nhóm.
[sqlfluff:layout:type:alias_expression]
spacing_before = any
